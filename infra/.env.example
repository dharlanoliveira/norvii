# Copy this file to infra/.env and replace both secret markers before startup.
# Single-quote values containing spaces, dollar signs, or other special characters.

NORVII_POSTGRES_HOST=localhost
NORVII_POSTGRES_PORT=5432
NORVII_POSTGRES_DATABASE=norvii
NORVII_POSTGRES_USER=norvii
NORVII_POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD

NORVII_NEO4J_HTTP_PORT=7474
NORVII_NEO4J_BOLT_PORT=7687
NORVII_NEO4J_URI=neo4j://localhost:7687
NORVII_NEO4J_USER=neo4j
NORVII_NEO4J_PASSWORD=REPLACE_WITH_LOCAL_NEO4J_PASSWORD
NORVII_NEO4J_DATABASE=neo4j

NORVII_PERSISTENCE_TIMEOUT_SECONDS=5

# API server configuration. Defaults bind only to the local interface.
NORVII_API_HOST=127.0.0.1
NORVII_API_PORT=8080
NORVII_API_MAX_REQUEST_BYTES=11534336
NORVII_API_SHUTDOWN_TIMEOUT_SECONDS=10
NORVII_API_READ_HEADER_TIMEOUT_SECONDS=5
NORVII_API_READ_TIMEOUT_SECONDS=15
NORVII_API_WRITE_TIMEOUT_SECONDS=30
NORVII_API_IDLE_TIMEOUT_SECONDS=60

# Ingestion worker and bounded acquisition configuration.
NORVII_INGESTION_POLL_SECONDS=1
NORVII_INGESTION_LEASE_SECONDS=120
NORVII_INGESTION_MAX_SOURCE_BYTES=10485760
NORVII_INGESTION_MAX_REDIRECTS=5
NORVII_INGESTION_CONNECT_TIMEOUT_SECONDS=5
NORVII_INGESTION_READ_TIMEOUT_SECONDS=15
NORVII_INGESTION_PIPELINE_VERSION=corpus-ingestion-v2
NORVII_INITIAL_INGESTION_TIMEOUT_SECONDS=90
