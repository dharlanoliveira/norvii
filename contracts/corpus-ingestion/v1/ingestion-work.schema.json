{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://norvii.dev/contracts/corpus-ingestion/v1/ingestion-work.schema.json",
  "title": "Norvii ingestion work v1",
  "oneOf": [
    {"$ref": "#/$defs/claim"},
    {"$ref": "#/$defs/publication"},
    {"$ref": "#/$defs/failure"}
  ],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workId", "corpusId", "sourceId", "sourceKind", "reason", "leaseToken", "leaseExpiresAt"],
      "properties": {
        "kind": {"const": "claim"}, "workId": {"$ref": "#/$defs/uuid"}, "corpusId": {"$ref": "#/$defs/uuid"}, "sourceId": {"$ref": "#/$defs/uuid"},
        "sourceKind": {"enum": ["url", "pdf"]}, "reason": {"enum": ["initial", "retry", "reprocess"]}, "leaseToken": {"$ref": "#/$defs/uuid"}, "leaseExpiresAt": {"type": "string", "format": "date-time"}
      }
    },
    "unit": {
      "type": "object",
      "required": ["id", "kind", "ordinal", "startOffset", "endOffset", "locator", "contentSha256"],
      "properties": {"id": {"$ref": "#/$defs/uuid"}, "parentId": {"type": ["string", "null"], "format": "uuid"}, "kind": {"type": "string"}, "ordinal": {"type": "integer", "minimum": 0}, "startOffset": {"type": "integer", "minimum": 0}, "endOffset": {"type": "integer", "minimum": 0}, "locator": {"type": "string"}, "contentSha256": {"$ref": "#/$defs/sha256"}}
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workId", "leaseToken", "pipelineVersion", "originSha256", "text", "textSha256", "units"],
      "properties": {"kind": {"const": "publication"}, "workId": {"$ref": "#/$defs/uuid"}, "leaseToken": {"$ref": "#/$defs/uuid"}, "pipelineVersion": {"type": "string"}, "originSha256": {"$ref": "#/$defs/sha256"}, "text": {"type": "string"}, "textSha256": {"$ref": "#/$defs/sha256"}, "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}}}
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workId", "leaseToken", "category"],
      "properties": {"kind": {"const": "failure"}, "workId": {"$ref": "#/$defs/uuid"}, "leaseToken": {"$ref": "#/$defs/uuid"}, "category": {"type": "string"}, "detail": {"type": ["string", "null"], "maxLength": 500}}
    }
  }
}
