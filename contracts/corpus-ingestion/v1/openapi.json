{
  "openapi": "3.1.0",
  "info": {
    "title": "Norvii Corpus Ingestion API",
    "version": "1.0.0"
  },
  "servers": [{"url": "/api/v1"}],
  "paths": {
    "/corpora": {
      "get": {"operationId": "listCorpora", "responses": {"200": {"description": "Corpus list", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Corpus"}}}}}}},
      "post": {"operationId": "createCorpus", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CorpusWrite"}}}}, "responses": {"201": {"description": "Created corpus", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Corpus"}}}}, "400": {"$ref": "#/components/responses/Error"}}}
    },
    "/corpora/{corpusId}": {
      "parameters": [{"$ref": "#/components/parameters/CorpusId"}],
      "get": {"operationId": "getCorpus", "responses": {"200": {"description": "Corpus", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Corpus"}}}}, "404": {"$ref": "#/components/responses/Error"}}},
      "patch": {"operationId": "updateCorpus", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CorpusUpdate"}}}}, "responses": {"200": {"description": "Updated corpus", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Corpus"}}}}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/corpora/{corpusId}/disable": {"post": {"operationId": "disableCorpus", "parameters": [{"$ref": "#/components/parameters/CorpusId"}], "requestBody": {"$ref": "#/components/requestBodies/VersionCommand"}, "responses": {"200": {"description": "Disabled corpus", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Corpus"}}}}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/corpora/{corpusId}/enable": {"post": {"operationId": "enableCorpus", "parameters": [{"$ref": "#/components/parameters/CorpusId"}], "requestBody": {"$ref": "#/components/requestBodies/VersionCommand"}, "responses": {"200": {"description": "Enabled corpus", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Corpus"}}}}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/corpora/{corpusId}/sources": {"get": {"operationId": "listSources", "parameters": [{"$ref": "#/components/parameters/CorpusId"}], "responses": {"200": {"description": "Source list", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Source"}}}}}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/corpora/{corpusId}/sources/url": {"post": {"operationId": "createUrlSource", "parameters": [{"$ref": "#/components/parameters/CorpusId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UrlSourceWrite"}}}}, "responses": {"202": {"description": "Accepted source", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Source"}}}}, "400": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/corpora/{corpusId}/sources/pdf": {"post": {"operationId": "createPdfSource", "parameters": [{"$ref": "#/components/parameters/CorpusId"}], "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["title", "file"], "properties": {"title": {"type": "string"}, "file": {"type": "string", "contentMediaType": "application/pdf"}}}}}}, "responses": {"202": {"description": "Accepted source", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Source"}}}}, "413": {"$ref": "#/components/responses/Error"}}}},
    "/corpora/{corpusId}/sources/{sourceId}": {"get": {"operationId": "getSource", "parameters": [{"$ref": "#/components/parameters/CorpusId"}, {"$ref": "#/components/parameters/SourceId"}], "responses": {"200": {"description": "Source", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Source"}}}}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/corpora/{corpusId}/sources/{sourceId}/retry": {"post": {"operationId": "retrySource", "parameters": [{"$ref": "#/components/parameters/CorpusId"}, {"$ref": "#/components/parameters/SourceId"}], "requestBody": {"$ref": "#/components/requestBodies/VersionCommand"}, "responses": {"202": {"description": "Retry accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Source"}}}}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/corpora/{corpusId}/sources/{sourceId}/reprocess": {"post": {"operationId": "reprocessSource", "parameters": [{"$ref": "#/components/parameters/CorpusId"}, {"$ref": "#/components/parameters/SourceId"}], "requestBody": {"$ref": "#/components/requestBodies/VersionCommand"}, "responses": {"202": {"description": "Reprocess accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Source"}}}}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/corpora/{corpusId}/sources/{sourceId}/document": {"get": {"operationId": "getLatestDocument", "parameters": [{"$ref": "#/components/parameters/CorpusId"}, {"$ref": "#/components/parameters/SourceId"}], "responses": {"200": {"description": "Latest ready document", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Document"}}}}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/corpora/{corpusId}/sources/{sourceId}/origin/url": {"get": {"operationId": "getUrlOrigin", "parameters": [{"$ref": "#/components/parameters/CorpusId"}, {"$ref": "#/components/parameters/SourceId"}], "responses": {"200": {"description": "Captured URL origin metadata", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SourceOrigin"}}}}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/corpora/{corpusId}/sources/{sourceId}/origin/pdf": {"get": {"operationId": "downloadPdfOrigin", "parameters": [{"$ref": "#/components/parameters/CorpusId"}, {"$ref": "#/components/parameters/SourceId"}], "responses": {"200": {"description": "Preserved PDF origin", "content": {"application/pdf": {"schema": {"type": "string", "contentMediaType": "application/pdf"}}}}, "404": {"$ref": "#/components/responses/Error"}}}}
  },
  "components": {
    "parameters": {
      "CorpusId": {"name": "corpusId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "SourceId": {"name": "sourceId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
    },
    "requestBodies": {"VersionCommand": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["version"], "properties": {"version": {"type": "integer", "minimum": 1}}}}}}},
    "responses": {"Error": {"description": "Safe error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}},
    "schemas": {
      "CorpusWrite": {"type": "object", "additionalProperties": false, "required": ["name", "description", "language", "jurisdiction"], "properties": {"name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "language": {"type": "string", "enum": ["en", "pt"]}, "jurisdiction": {"type": "string", "minLength": 1}}},
      "CorpusUpdate": {"allOf": [{"$ref": "#/components/schemas/CorpusWrite"}, {"type": "object", "required": ["version"], "properties": {"version": {"type": "integer", "minimum": 1}}}]},
      "Corpus": {"allOf": [{"$ref": "#/components/schemas/CorpusWrite"}, {"type": "object", "required": ["id", "status", "sourceCount", "version", "createdAt", "updatedAt"], "properties": {"id": {"type": "string", "format": "uuid"}, "status": {"type": "string", "enum": ["enabled", "disabled"]}, "sourceCount": {"type": "integer", "minimum": 0}, "version": {"type": "integer", "minimum": 1}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}}}]},
      "UrlSourceWrite": {"type": "object", "additionalProperties": false, "required": ["title", "url"], "properties": {"title": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}}},
      "Source": {"type": "object", "required": ["id", "corpusId", "title", "kind", "processingStatus", "version", "createdAt", "updatedAt", "origin", "latestAttempt", "attempts"], "properties": {"id": {"type": "string", "format": "uuid"}, "corpusId": {"type": "string", "format": "uuid"}, "title": {"type": "string"}, "kind": {"type": "string", "enum": ["url", "pdf"]}, "processingStatus": {"type": "string", "enum": ["pending", "processing", "ready", "failed"]}, "failureCategory": {"type": ["string", "null"]}, "latestReadyDocumentId": {"type": ["string", "null"], "format": "uuid"}, "version": {"type": "integer", "minimum": 1}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}, "origin": {"$ref": "#/components/schemas/SourceOrigin"}, "latestAttempt": {"oneOf": [{"$ref": "#/components/schemas/ProcessingAttempt"}, {"type": "null"}]}, "attempts": {"type": "array", "items": {"$ref": "#/components/schemas/ProcessingAttempt"}}}},
      "SourceOrigin": {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string", "enum": ["url", "pdf"]}, "submittedUrl": {"type": "string", "format": "uri"}, "normalizedUrl": {"type": "string", "format": "uri"}, "originalFilename": {"type": "string"}, "mediaType": {"type": "string"}, "byteSize": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "finalUrl": {"type": "string", "format": "uri"}, "capturedAt": {"type": "string", "format": "date-time"}, "extractedContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
      "ProcessingAttempt": {"type": "object", "required": ["number", "pipelineVersion", "status", "startedAt"], "properties": {"number": {"type": "integer", "minimum": 1}, "pipelineVersion": {"type": "string"}, "status": {"type": "string", "enum": ["processing", "succeeded", "failed"]}, "startedAt": {"type": "string", "format": "date-time"}, "finishedAt": {"type": ["string", "null"], "format": "date-time"}, "failureCategory": {"type": ["string", "null"]}, "acquiredByteCount": {"type": ["integer", "null"], "minimum": 0}, "normalizedCharacterCount": {"type": ["integer", "null"], "minimum": 0}, "unitCount": {"type": ["integer", "null"], "minimum": 0}, "durationMilliseconds": {"type": ["integer", "null"], "minimum": 0}}},
      "DocumentUnit": {"type": "object", "required": ["id", "kind", "ordinal", "startOffset", "endOffset", "locator", "contentSha256"], "properties": {"id": {"type": "string", "format": "uuid"}, "parentId": {"type": ["string", "null"], "format": "uuid"}, "kind": {"type": "string", "enum": ["document", "title", "chapter", "section", "article", "paragraph", "item", "recital", "page", "block"]}, "ordinal": {"type": "integer", "minimum": 0}, "marker": {"type": ["string", "null"]}, "label": {"type": ["string", "null"]}, "startOffset": {"type": "integer", "minimum": 0}, "endOffset": {"type": "integer", "minimum": 0}, "locator": {"type": "string"}, "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
      "Document": {"type": "object", "required": ["id", "sourceRevisionId", "pipelineVersion", "text", "textSha256", "createdAt", "units", "provenance"], "properties": {"id": {"type": "string", "format": "uuid"}, "sourceRevisionId": {"type": "string", "format": "uuid"}, "pipelineVersion": {"type": "string"}, "text": {"type": "string"}, "textSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "createdAt": {"type": "string", "format": "date-time"}, "units": {"type": "array", "items": {"$ref": "#/components/schemas/DocumentUnit"}}, "provenance": {"$ref": "#/components/schemas/RevisionProvenance"}}},
      "RevisionProvenance": {"type": "object", "required": ["contentSha256", "capturedAt", "mediaType", "byteSize", "finalUrl", "extractedContentSha256"], "properties": {"contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "capturedAt": {"type": "string", "format": "date-time"}, "mediaType": {"type": "string"}, "byteSize": {"type": "integer", "minimum": 1}, "finalUrl": {"type": ["string", "null"], "format": "uri"}, "extractedContentSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}},
      "ErrorEnvelope": {"type": "object", "required": ["error"], "properties": {"error": {"type": "object", "required": ["code", "message", "requestId"], "properties": {"code": {"type": "string", "enum": ["invalid_input", "payload_too_large", "unsafe_url", "unsupported_content", "duplicate_source", "stale_state", "not_found", "unavailable", "acquisition_failed", "extraction_failed", "publication_failed", "internal_error"]}, "message": {"type": "string"}, "fields": {"type": "object", "additionalProperties": {"type": "string"}}, "requestId": {"type": "string", "format": "uuid"}}}}
    }
  }
}
}
