{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://norvii.dev/contracts/grounded-chat/v1/stream-event.json",
  "title": "Norvii Grounded Chat Stream Event",
  "oneOf": [
    { "$ref": "#/$defs/started" },
    { "$ref": "#/$defs/evidence" },
    { "$ref": "#/$defs/delta" },
    { "$ref": "#/$defs/completed" },
    { "$ref": "#/$defs/abstained" },
    { "$ref": "#/$defs/cancelled" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "language": { "type": "string", "enum": ["en", "pt"] },
    "requestId": { "type": "string", "format": "uuid" },
    "base": {
      "type": "object",
      "required": ["type", "requestId"],
      "properties": {
        "type": { "type": "string" },
        "requestId": { "$ref": "#/$defs/requestId" }
      },
      "additionalProperties": true
    },
    "reference": {
      "type": "object",
      "required": ["id", "corpusId", "snapshotId", "sourceId", "documentId", "unitLocator", "startOffset", "endOffset", "excerpt", "rank"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "corpusId": { "$ref": "#/$defs/uuid" },
        "snapshotId": { "$ref": "#/$defs/uuid" },
        "sourceId": { "$ref": "#/$defs/uuid" },
        "documentId": { "$ref": "#/$defs/uuid" },
        "documentVersionId": { "$ref": "#/$defs/uuid" },
        "sourceRevisionId": { "$ref": "#/$defs/uuid" },
        "pipelineVersion": { "type": "string", "minLength": 1 },
        "sourceTitle": { "type": "string", "minLength": 1 },
        "unitLocator": { "type": "string", "minLength": 1 },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 0 },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "rank": { "type": "integer", "minimum": 1 },
        "cosineDistance": { "type": ["number", "null"], "minimum": 0 },
        "contribution": { "type": "string", "enum": ["vector", "graph", "both"] }
      },
      "additionalProperties": false
    },
    "started": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "started" },
        "corpusId": { "$ref": "#/$defs/uuid" }
      },
      "required": ["type", "requestId", "corpusId"]
    },
    "evidence": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "evidence" },
        "references": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/reference" } }
      },
      "required": ["type", "requestId", "references"]
    },
    "delta": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "delta" },
        "text": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "requestId", "text"]
    },
    "completed": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "completed" },
        "answer": { "type": "string", "minLength": 1 },
        "references": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/reference" } },
        "telemetry": { "$ref": "#/$defs/telemetry" },
        "inspection": { "$ref": "#/$defs/inspection" }
      },
      "required": ["type", "requestId", "answer", "references", "telemetry"]
    },
    "abstained": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "abstained" },
        "reason": { "type": "string", "enum": ["insufficient_evidence", "evidence_unavailable", "grounding_validation_failed", "graph_unavailable", "hybrid_unavailable"] },
        "telemetry": { "$ref": "#/$defs/telemetry" },
        "inspection": { "$ref": "#/$defs/inspection" }
      },
      "required": ["type", "requestId", "reason", "telemetry"]
    },
    "cancelled": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "cancelled" },
        "telemetry": { "$ref": "#/$defs/telemetry" },
        "inspection": { "$ref": "#/$defs/inspection" }
      },
      "required": ["type", "requestId", "telemetry"]
    },
    "error": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "error" },
        "code": { "type": "string", "enum": ["invalid_question", "corpus_unavailable", "snapshot_unavailable", "graph_unavailable", "insufficient_evidence", "retrieval_failed", "generation_failed", "request_cancelled", "evidence_unavailable", "internal_error"] },
        "message": { "type": "string", "minLength": 1 },
        "telemetry": { "$ref": "#/$defs/telemetry" },
        "inspection": { "$ref": "#/$defs/inspection" }
      },
      "required": ["type", "requestId", "code", "message", "telemetry"]
    },
    "telemetry": {
      "type": "object",
      "required": ["outcome", "evidenceCount", "durationMilliseconds"],
      "properties": {
        "outcome": { "type": "string", "minLength": 1 },
        "evidenceCount": { "type": "integer", "minimum": 0, "maximum": 8 },
        "durationMilliseconds": { "type": "integer", "minimum": 0 },
        "embeddingModel": { "type": ["string", "null"] },
        "chatModel": { "type": ["string", "null"] },
        "inputCharacters": { "type": ["integer", "null"], "minimum": 0 },
        "outputCharacters": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "inspection": {
      "type": "object",
      "required": ["outcome", "measurements"],
      "properties": {
        "outcome": { "type": "string", "enum": ["completed", "abstained", "cancelled", "failed"] },
        "retrieval": {
          "type": "object",
          "required": ["strategy", "topK", "returnedCount", "embeddingModel"],
          "properties": {
            "strategy": { "type": "string", "enum": ["vector", "graph", "hybrid"] },
            "topK": { "type": "integer", "minimum": 0 },
            "returnedCount": { "type": "integer", "minimum": 0, "maximum": 8 },
            "embeddingModel": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "measurements": {
          "type": "object",
          "required": ["retrievalMilliseconds", "generationMilliseconds", "totalMilliseconds", "inputTokens", "outputTokens"],
          "properties": {
            "retrievalMilliseconds": { "type": ["integer", "null"], "minimum": 0 },
            "generationMilliseconds": { "type": ["integer", "null"], "minimum": 0 },
            "totalMilliseconds": { "type": ["integer", "null"], "minimum": 0 },
            "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
            "outputTokens": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "evidence": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/reference" } },
        "graphPath": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["relationshipType", "subjectLabel", "objectLabel", "evidenceId", "evidenceLocator"],
            "properties": {
              "relationshipType": { "type": "string", "minLength": 1 },
              "subjectLabel": { "type": "string", "minLength": 1 },
              "objectLabel": { "type": "string", "minLength": 1 },
              "evidenceId": { "type": "string", "minLength": 1 },
              "evidenceLocator": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
