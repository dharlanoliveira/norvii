{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://norvii.dev/contracts/grounded-chat/v1/stream-event.json",
  "title": "Norvii Grounded Chat Stream Event",
  "oneOf": [
    { "$ref": "#/$defs/started" },
    { "$ref": "#/$defs/evidence" },
    { "$ref": "#/$defs/delta" },
    { "$ref": "#/$defs/completed" },
    { "$ref": "#/$defs/abstained" },
    { "$ref": "#/$defs/cancelled" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "language": { "type": "string", "enum": ["en", "pt"] },
    "requestId": { "type": "string", "format": "uuid" },
    "base": {
      "type": "object",
      "required": ["type", "requestId"],
      "properties": {
        "type": { "type": "string" },
        "requestId": { "$ref": "#/$defs/requestId" }
      },
      "additionalProperties": true
    },
    "reference": {
      "type": "object",
      "required": ["id", "corpusId", "sourceId", "documentId", "unitLocator", "startOffset", "endOffset", "excerpt", "rank"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "corpusId": { "$ref": "#/$defs/uuid" },
        "sourceId": { "$ref": "#/$defs/uuid" },
        "documentId": { "$ref": "#/$defs/uuid" },
        "unitLocator": { "type": "string", "minLength": 1 },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 0 },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "rank": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "started": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "started" },
        "corpusId": { "$ref": "#/$defs/uuid" }
      },
      "required": ["type", "requestId", "corpusId"]
    },
    "evidence": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "evidence" },
        "references": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/reference" } }
      },
      "required": ["type", "requestId", "references"]
    },
    "delta": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "delta" },
        "text": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "requestId", "text"]
    },
    "completed": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "completed" },
        "answer": { "type": "string", "minLength": 1 },
        "references": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/reference" } },
        "telemetry": { "$ref": "#/$defs/telemetry" }
      },
      "required": ["type", "requestId", "answer", "references", "telemetry"]
    },
    "abstained": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "abstained" },
        "reason": { "type": "string", "enum": ["insufficient_evidence", "evidence_unavailable", "grounding_validation_failed"] },
        "telemetry": { "$ref": "#/$defs/telemetry" }
      },
      "required": ["type", "requestId", "reason", "telemetry"]
    },
    "cancelled": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "cancelled" },
        "telemetry": { "$ref": "#/$defs/telemetry" }
      },
      "required": ["type", "requestId", "telemetry"]
    },
    "error": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "properties": {
        "type": { "const": "error" },
        "code": { "type": "string", "enum": ["invalid_question", "corpus_unavailable", "insufficient_evidence", "retrieval_failed", "generation_failed", "request_cancelled", "evidence_unavailable", "internal_error"] },
        "message": { "type": "string", "minLength": 1 },
        "telemetry": { "$ref": "#/$defs/telemetry" }
      },
      "required": ["type", "requestId", "code", "message", "telemetry"]
    },
    "telemetry": {
      "type": "object",
      "required": ["outcome", "evidenceCount", "durationMilliseconds"],
      "properties": {
        "outcome": { "type": "string", "minLength": 1 },
        "evidenceCount": { "type": "integer", "minimum": 0, "maximum": 8 },
        "durationMilliseconds": { "type": "integer", "minimum": 0 },
        "embeddingModel": { "type": ["string", "null"] },
        "chatModel": { "type": ["string", "null"] },
        "inputCharacters": { "type": ["integer", "null"], "minimum": 0 },
        "outputCharacters": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
